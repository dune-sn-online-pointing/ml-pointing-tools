# Condor submit file for CT v40 - corrected data 10k test
universe                = vanilla
executable              = /afs/cern.ch/work/e/evilla/private/dune/ml-pointing-tools/scripts/channel_tagging/condor/wrapper_ct_simple.sh
arguments               = -j /afs/cern.ch/work/e/evilla/private/dune/ml-pointing-tools/channel_tagging/json/volume_v40_corrected_10k.json

# Resource requests
request_cpus            = 4
request_memory          = 40GB
request_gpus            = 1
request_disk            = 5GB

# Job requirements
+JobFlavour             = "nextweek"
requirements            = (OpSysAndVer =?= "AlmaLinux9")

# Working directory
initialdir              = /afs/cern.ch/work/e/evilla/private/dune/ml-pointing-tools

# Environment
getenv                  = True

# Output files
log                     = /afs/cern.ch/work/e/evilla/private/dune/ml-pointing-tools/channel_tagging/logs/CT_v40_$(Cluster).log
output                  = /afs/cern.ch/work/e/evilla/private/dune/ml-pointing-tools/channel_tagging/logs/CT_v40_$(Cluster).out
error                   = /afs/cern.ch/work/e/evilla/private/dune/ml-pointing-tools/channel_tagging/logs/CT_v40_$(Cluster).err

# Notification
notification            = Error

# Submit
queue 1
