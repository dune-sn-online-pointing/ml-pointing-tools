############################################################
# HTCondor Submit File for Channel Tagging v72_deeper - FIXED
# Save to /eos instead of local training_output
############################################################

# Job configuration
executable              = condor/run_ct_v72_deeper_20k.sh

# Output and error logs
output                  = logs/ct_v72_deeper_20k_$(ClusterId).out
error                   = logs/ct_v72_deeper_20k_$(ClusterId).err
log                     = logs/ct_v72_deeper_20k_$(ClusterId).log

# Resource requests
request_cpus            = 4
request_memory          = 60GB
request_gpus            = 1

# Time limit
+JobFlavour             = "nextweek"

# Notification
notification            = Error
notify_user             = evilla@cern.ch

# Queue the job
queue 1
