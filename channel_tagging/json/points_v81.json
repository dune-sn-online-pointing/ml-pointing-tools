    "train_cats": [400, 571],
    "val_cats": [572, 596],
    "test_cats": [597, 621],
    "max_train_per_class": 40000,
    "max_val_per_class": 5000,
    "max_test_per_class": 8000
  },
  "training": {
    "epochs": 100,
    "batch_size": 128,
    "learning_rate": 0.001,
    "patience": 15,
    "augment": true,
    "seed": 42
  },
  "output": {
    "base_dir": "/eos/user/e/evilla/dune/sn-tps/neural_networks/channel_tagging"
  }
