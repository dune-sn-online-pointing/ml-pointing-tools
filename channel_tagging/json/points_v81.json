{
  "version": "v81",
  "description": "CT v81: sparse point-cloud (DeepSets) model on nonzero pixels of burst-sample volumes + truth-free aux features. Same cat-level splits as v80.",
  "model_name": "ct_points_v81",
  "model": {
    "max_points": 1024,
    "point_mlp": [64, 128, 256],
    "head_units": [128, 64],
    "dropout_rate": 0.3
  },
  "data": {
    "burst_samples_dir": "/eos/project-e/ep-nu/evilla/sn-online-pointing/sn-burst-samples",
