# Pack the matcher-fixed ES production pool into train/val/test npy shards
universe                = vanilla
executable              = /afs/cern.ch/work/e/evilla/private/dune/refactor-ml-for-pointing/electron_direction/scripts/wrapper_pack_prodes.sh
arguments               = --images-dir /eos/project-e/ep-nu/evilla/sn-online-pointing/prod_es_matchfix/es_production_cluster_images_tick3_ch2_min2_tot3_e2p0_matchfix --out-dir /eos/project-e/ep-nu/evilla/sn-online-pointing/prod_es_matchfix/packed_v58sel_seed42 --seed 42

request_cpus            = 2
request_memory          = 32GB
request_disk            = 5GB

+JobFlavour             = "tomorrow"
requirements            = (OpSysAndVer =?= "AlmaLinux9")

initialdir              = /afs/cern.ch/work/e/evilla/private/dune/refactor-ml-for-pointing
getenv                  = True
environment             = "MLPT_REPO_DIR=/afs/cern.ch/work/e/evilla/private/dune/refactor-ml-for-pointing"

log                     = /afs/cern.ch/work/e/evilla/private/dune/refactor-ml-for-pointing/electron_direction/condor/logs/pack_prodes_$(Cluster).log
output                  = /afs/cern.ch/work/e/evilla/private/dune/refactor-ml-for-pointing/electron_direction/condor/logs/pack_prodes_$(Cluster).out
error                   = /afs/cern.ch/work/e/evilla/private/dune/refactor-ml-for-pointing/electron_direction/condor/logs/pack_prodes_$(Cluster).err

notification            = Error
queue 1
