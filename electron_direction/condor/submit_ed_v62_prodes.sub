# ED v62: three-plane ED training on the matcher-fixed ES production pool
universe                = vanilla
executable              = /afs/cern.ch/work/e/evilla/private/dune/refactor-ml-for-pointing/electron_direction/scripts/wrapper_ed_v62_prodes.sh
arguments               = -j /afs/cern.ch/work/e/evilla/private/dune/refactor-ml-for-pointing/electron_direction/json/three_plane_v62_prodes_matchfix.json

request_cpus            = 4
request_memory          = 30GB
request_gpus            = 1
request_disk            = 10GB

+JobFlavour             = "tomorrow"
requirements            = (OpSysAndVer =?= "AlmaLinux9")

initialdir              = /afs/cern.ch/work/e/evilla/private/dune/refactor-ml-for-pointing
getenv                  = True

log                     = /afs/cern.ch/work/e/evilla/private/dune/refactor-ml-for-pointing/electron_direction/condor/logs/ED_v62_prodes_matchfix_$(Cluster).log
output                  = /afs/cern.ch/work/e/evilla/private/dune/refactor-ml-for-pointing/electron_direction/condor/logs/ED_v62_prodes_matchfix_$(Cluster).out
error                   = /afs/cern.ch/work/e/evilla/private/dune/refactor-ml-for-pointing/electron_direction/condor/logs/ED_v62_prodes_matchfix_$(Cluster).err

notification            = Error
queue 1
