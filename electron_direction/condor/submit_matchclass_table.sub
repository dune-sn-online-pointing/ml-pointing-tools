# SAME / CHANGED / NEW / LOST table: fixed vs legacy partner rule on the same clusters
universe                = vanilla
executable              = /afs/cern.ch/work/e/evilla/private/dune/refactor-ml-for-pointing/electron_direction/scripts/wrapper_ed_ana.sh
